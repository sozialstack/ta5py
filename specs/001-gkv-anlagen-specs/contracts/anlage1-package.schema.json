{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.clearing/format/contracts/anlage1-package.schema.json",
  "title": "Anlage1AmbulancePackage",
  "description": "Layout contract for packages/ta5py/spec/vN ambulance (SLLA:E) Anlage 1 packages. Not the official PDF.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version_label", "provenance", "una", "messages", "segments"],
  "properties": {
    "version_label": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "required": ["scope", "publications"],
      "properties": {
        "scope": { "const": "krankentransport" },
        "publications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["anlage_id", "version", "stand_date"],
            "properties": {
              "anlage_id": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 },
              "stand_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "applicable_from": { "type": "string" },
              "source_url": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "una": {
      "type": "object",
      "required": ["component", "element", "decimal", "release", "segment_end"],
      "properties": {
        "component": { "type": "string", "minLength": 1, "maxLength": 1 },
        "element": { "type": "string", "minLength": 1, "maxLength": 1 },
        "decimal": { "type": "string", "minLength": 1, "maxLength": 1 },
        "release": { "type": "string", "minLength": 1, "maxLength": 1 },
        "segment_end": { "type": "string", "minLength": 1, "maxLength": 1 }
      }
    },
    "messages": {
      "type": "object",
      "required": ["slla_e"],
      "properties": {
        "slla_e": { "$ref": "#/$defs/messageType" },
        "slga": { "$ref": "#/$defs/messageType" }
      },
      "additionalProperties": { "$ref": "#/$defs/messageType" }
    },
    "segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/segmentDefinition" }
    },
    "catalog_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "messageType": {
      "type": "object",
      "required": ["code", "segments"],
      "properties": {
        "code": { "type": "string" },
        "profile": { "type": "string" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["segment", "usage"],
            "properties": {
              "segment": { "type": "string" },
              "usage": { "enum": ["M", "K"] },
              "repeat": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "segmentDefinition": {
      "type": "object",
      "required": ["code", "name", "fields"],
      "properties": {
        "code": { "type": "string", "minLength": 3, "maxLength": 3 },
        "name": { "type": "string" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "position", "usage", "value_type"],
            "properties": {
              "name": { "type": "string" },
              "official_label": { "type": "string" },
              "position": { "type": "integer", "minimum": 1 },
              "max_length": { "type": ["string", "integer"] },
              "value_type": { "type": "string" },
              "usage": { "enum": ["M", "K"] },
              "catalog_ref": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
