{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/clearing/format/spec/v20/dataset.schema.json",
  "title": "SyntheticClaimDatasetV20",
  "description": "Minimal v20 slice for synthetic ambulance claim fields (not a full Anlage).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ik_sender", "ik_receiver", "leistungsdatum", "km", "positions"],
  "properties": {
    "ik_sender": {
      "type": "string",
      "pattern": "^[0-9]{9}$",
      "description": "Sender Institutionskennzeichen"
    },
    "ik_receiver": {
      "type": "string",
      "pattern": "^[0-9]{9}$",
      "description": "Receiver / Kostenträger IK"
    },
    "leistungsdatum": {
      "type": "string",
      "pattern": "^[0-9]{8}$",
      "description": "Service date YYYYMMDD"
    },
    "km": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "amount_cents"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 10 },
          "amount_cents": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
